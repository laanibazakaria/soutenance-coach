GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AUTH_SECRET=
DATABASE_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Adresse de l'administrateur (tableau de bord /app/admin, sans quota)
ADMIN_EMAIL=
# Quotas d'appels IA par mois civil (défauts : 20 sans compte, 80 avec)
QUOTA_ANONYME=
QUOTA_COMPTE=

# Notifications push : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Secret de la tâche planifiée (Vercel l envoie en Authorization: Bearer)
CRON_SECRET=

# IA en cascade (toutes facultatives ; l'ordre d'essai est dans lib/llm.ts).
# Mistral (qualité en français) → Groq (vitesse) → Gemini.
MISTRAL_API_KEY=
GROQ_API_KEY=

# E-mails (lien de connexion, débriefs, rappels). EMAIL_FROM une fois le domaine vérifié chez Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Envoi par Gmail SMTP (gratuit, sans domaine) : un compte Gmail dédié + mot de passe d'application.
GMAIL_UTILISATEUR=
GMAIL_MDP_APPLICATION=
