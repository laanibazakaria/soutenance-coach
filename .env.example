GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AUTH_SECRET=
DATABASE_URL=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Adresse de l'administrateur (tableau de bord /app/admin, sans quota)
ADMIN_EMAIL=
# Quotas d'appels IA par mois civil (défauts : 20 sans compte, 80 avec)
QUOTA_ANONYME=
QUOTA_COMPTE=

# Notifications push : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Secret de la tâche planifiée (Vercel l envoie en Authorization: Bearer)
CRON_SECRET=

# IA en cascade (toutes facultatives ; l'ordre d'essai est dans lib/llm.ts).
# Mistral (qualité en français) → Groq (vitesse) → Gemini.
MISTRAL_API_KEY=
GROQ_API_KEY=

# E-mails (lien de connexion, débriefs, rappels). EMAIL_FROM une fois le domaine vérifié chez Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Envoi par Gmail SMTP (gratuit, sans domaine) : un compte Gmail dédié + mot de passe d'application.
GMAIL_UTILISATEUR=
GMAIL_MDP_APPLICATION=

# ── Fournisseurs IA de secours (tous facultatifs : la cascade utilise ce qui est configuré) ──
# Ordre : Mistral (français) → Groq (vitesse) → Gemini → les suivants.
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
CEREBRAS_API_KEY=
ZAI_API_KEY=
OVH_API_KEY=
HF_API_KEY=
KILO_API_KEY=
COHERE_API_KEY=
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# OmniRoute (MIT, https://github.com/diegosouzapw/OmniRoute) : passerelle vers 350
# fournisseurs derrière un point d'entrée compatible OpenAI, avec son propre repli.
# Elle tourne en local (`npx omniroute`, port 20128) : renseigne l'URL pour la mettre
# en tête de cascade. Vide = la cascade appelle les fournisseurs directement.
OMNIROUTE_URL=
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=
