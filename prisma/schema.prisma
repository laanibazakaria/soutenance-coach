// Schéma de la plateforme. Deux familles de tables :
// - celles d'Auth.js (User, Account, Session, VerificationToken), au format
//   attendu par @auth/prisma-adapter ;
// - celles du produit (TrainingSession, Deck, IaResult), qui reprennent
//   exactement les formes déjà stockées localement — la synchronisation est
//   une copie, pas une traduction.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/* ── Auth.js ─────────────────────────────────────────────────────────── */

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  /// Empreinte bcrypt pour les comptes e-mail + mot de passe (null : Google ou lien magique).
  motDePasse    String?
  createdAt     DateTime  @default(now())

  accounts         Account[]
  sessions         Session[]
  trainingSessions TrainingSession[]
  deck             Deck?
  iaResults        IaResult[]
  parcours         Parcours?
  candidature      Candidature?
  profils          ProfilModule[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

/* ── Produit ─────────────────────────────────────────────────────────── */

/// Une session d'entraînement oral. L'identifiant est celui généré par le
/// navigateur : une même session envoyée deux fois ne crée pas de doublon.
model TrainingSession {
  id               String   @id
  userId           String
  startedAt        DateTime
  durationMs       Int
  transcript       String
  wordCount        Int
  confidence       Float?
  targetDurationMs Int?
  /// Temps par diapositive (répétition avec le support), même forme qu'en local.
  slides           Json?
  /// "soutenance" (défaut) ou "entretien".
  mode             String?
  createdAt        DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

/// Le support de présentation courant — un par utilisateur. Seul le texte
/// extrait est stocké, jamais le PDF.
model Deck {
  userId     String   @id
  nomFichier String
  slides     Json
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Résultats IA (pitch, questions) indexés par la même clé que le cache local.
model IaResult {
  userId    String
  cle       String
  valeur    Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, cle])
}

/// Le parcours J-X — un par utilisateur, même forme que le stockage local.
model Parcours {
  userId         String   @id
  dateSoutenance String
  type           String
  dureeMin       Int
  creeLe         String
  etapesFaites   Json
  misAJourLe     DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Le module Entretien : poste, offre, texte du CV (jamais le fichier), checklist.
model Candidature {
  userId        String   @id
  poste         String
  entreprise    String
  typeEntretien String
  dateEntretien String?
  offre         String
  cvTexte       String
  cvNomFichier  String?
  etapesFaites  Json
  misAJourLe    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Profil d'un module d'oral (pitch, concours) — champs libres + texte du dossier.
model ProfilModule {
  userId        String
  module        String
  champs        Json
  documentTexte String
  documentNom   String?
  date          String?
  etapesFaites  Json
  misAJourLe    DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, module])
}

/// Compteur d'appels IA par appelant (compte ou empreinte d'adresse) et par mois civil.
model Usage {
  cle    String
  mois   String
  appels Int    @default(0)

  @@id([cle, mois])
}

/// Liste d'attente de l'offre Pro.
model Interet {
  email  String   @id
  creeLe DateTime @default(now())
}

/// Un bilan partagé en lecture seule — sans transcription, expire.
model Partage {
  id      String   @id
  contenu Json
  creeLe  DateTime @default(now())
  expire  DateTime
}

/// Un abonnement aux notifications push — lié au compte s'il y en a un.
model PushAbonnement {
  endpoint String   @id
  p256dh   String
  auth     String
  userId   String?
  fuseau   String?
  creeLe   DateTime @default(now())

  @@index([userId])
}

/// Un oral raconté après coup : les vraies questions, anonymes, modérées.
model RetourOral {
  id        String   @id @default(cuid())
  type      String
  ecole     String
  filiere   String
  niveau    String
  annee     Int
  questions Json
  ressenti  String?
  conseil   String?
  approuve  Boolean  @default(false)
  creeLe    DateTime @default(now())

  @@index([approuve, type])
}
